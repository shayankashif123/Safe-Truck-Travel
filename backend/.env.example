# Copy this file to backend/.env (never commit .env).

# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# https://developer.tomtom.com -> Keys. Needs Routing, Geocoding and Places Search APIs.
TOMTOM_API_KEY=
